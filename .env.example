# Google Cloud API 키 — Places API (New) 호출용 (서버 전용, 브라우저에 노출되지 않음)
# console.cloud.google.com → "Places API (New)" 사용 설정 → 사용자 인증 정보 만들기
# 없으면 링크의 URL 파싱만으로 등록되고, 사진·리뷰·평점은 표시되지 않습니다.
GOOGLE_API_KEY=

# 지도 표시용 브라우저 키 — Maps JavaScript API 사용 설정 필요.
# 이 키는 프론트로 내려가므로 HTTP 리퍼러 제한을 반드시 걸어주세요.
# 비워두면 위의 GOOGLE_API_KEY 를 사용합니다(권장하지 않음).
GOOGLE_MAPS_BROWSER_KEY=

# 관리자로 지정할 닉네임. 이 닉네임으로 가입하면 관리자 권한이 부여됩니다.
ADMIN_NICKNAME=

# 세션 쿠키 서명 비밀 — 비워두면 서버 시작 시 임시 생성 (재시작하면 모두 로그아웃)
SESSION_SECRET=

# 포트 (기본 3100)
PORT=3100
